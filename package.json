{
  "name": "next-resume-generator",
  "version": "2.0.3",
  "author": {
    "name": "Colin Hemphill",
    "email": "colin@colinhemphill.com",
    "url": "https://colinhemphill.com"
  },
  "keywords": [
    "resume",
    "generator",
    "nextjs",
    "pdf"
  ],
  "homepage": "https://github.com/colinhemphill/nextjs-resume-generator",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "analyze": "ANALYZE=true next build --webpack",
    "build": "next build --webpack",
    "copy": "copyfiles --flat edit-me/config/**/*.{png,ico,json} public",
    "dev": "next dev --webpack",
    "format": "prettier --write 'src/**/*.{json,js,ts,tsx}'",
    "lint": "eslint .",
    "prepare": "husky && npm run copy",
    "start": "next start",
    "test": "jest",
    "test:staged": "jest  --updateSnapshot --onlyChanged",
    "test:update": "jest --updateSnapshot",
    "types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dessert-box/react": "^0.7.5",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/css-utils": "^0.1.6",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.0",
    "blob-stream": "^0.1.3",
    "classnames": "^2.5.1",
    "front-matter": "^4.0.2",
    "indefinite": "^2.5.2",
    "marked": "^18.0.7",
    "next": "^16.2.11",
    "normalize.css": "^8.0.1",
    "polished": "^4.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pdf-html": "^2.1.5",
    "react-transition-group": "^4.4.5",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-transition-group": "^4.4.12",
    "@vanilla-extract/babel-plugin": "1.2.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.1.1",
    "next-router-mock": "^1.0.5",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.22"
  }
}
