{
  "compilerOptions": {
    "target": "esnext", // 1. Updated: Dropped ES2020 for TS 7 native compliance
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true, // 2. Updated: Mandatory in TS 7.0
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx", // 3. Updated: Next.js 16 handles compilation; tsc must preserve
    "incremental": true,
    // Only globals-only @types packages need listing here. "node", "react" etc.
    // arrive via normal module resolution because the code imports them;
    // @types/jest is never imported, so without this entry the test globals
    // (describe/it/expect/jest) are missing.
    "types": [
      "jest"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
